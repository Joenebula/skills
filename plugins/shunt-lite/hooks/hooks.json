{
  "description": "Size gate — redirects oversized reads to the Explore subagent",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check-file-size.js"],
            "timeout": 10,
            "statusMessage": "Checking file size"
          }
        ]
      }
    ]
  }
}
